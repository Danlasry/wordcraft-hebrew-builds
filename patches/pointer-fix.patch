+    /// The Windows software pointer follows the physical mouse in both interface directions,
+    /// including when a sidebar changes the canvas's horizontal offset.
+    #[test]
+    fn pointer_tracks_mouse() {
+        use egui::{Context, Event, Pos2, RawInput, Rect, pos2, vec2};
+        for rtl in [false, true] {
+            for left in [0.0, 80.0] {
+                let ctx = Context::default();
+                let canvas = Rect::from_min_max(pos2(left, 40.0), pos2(320.0, 280.0));
+                for x in [140.0, 180.0, 220.0] {
+                    let at = pos2(x, 120.0);
+                    let mut out = egui::FullOutput::default();
+                    for _ in 0..3 {
+                        crate::mirror::configure(&ctx, rtl, Some(canvas), &[], &[]);
+                        out = ctx.run_ui(
+                            RawInput {
+                                screen_rect: Some(Rect::from_min_size(Pos2::ZERO, vec2(400.0, 300.0))),
+                                events: vec![Event::PointerMoved(at)],
+                                ..Default::default()
+                            },
+                            |ui| {
+                                ui.ctx().set_cursor_icon(CursorIcon::Text);
+                                let p = ui.ctx().pointer_hover_pos().unwrap();
+                                assert!(super::replace(ui.ctx(), p, wordcraft_doc::props::Rgb(255, 255, 255)));
+                            },
+                        );
+                        out.textures_delta.clear();
+                    }
+                    let stem = out.shapes.iter().find_map(|c| match &c.shape {
+                        Shape::LineSegment { points: [a, b], stroke }
+                            if a.x == b.x && stroke.width == 1.0 && (b.y - a.y - 16.0).abs() < 0.01 => Some(a.x),
+                        _ => None,
+                    }).expect("software pointer stem");
+                    assert!((stem - at.x).abs() <= 0.5, "rtl={rtl}, canvas_left={left}: mouse={x}, stem={stem}");
+                }
+            }
+        }
+    }
