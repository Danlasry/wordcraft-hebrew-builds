+    rtl.then(|| INTERFACE_RTL_FACES.iter().filter(|f| db.has_family(f)).map(|f| db.face(f, "Regular")).find(|face| face.covers(c)))
+        .flatten()
+        .or_else(|| db.fallback_for(c, u32::MAX))
+}
