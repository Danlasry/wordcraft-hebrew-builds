+        assert!(matches!(input.events[2], Event::PointerMoved(p) if p == pos2(5.0, 10.0)), "on the mirrored page: shifted");
+        // A context menu laid out at 10–30 and mirrored about 130 (`2a + d`) is drawn at 100–120.
